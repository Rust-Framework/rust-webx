# Copy to dmbit/.env and fill in before `docker compose up`.
# Required for production (APP_ENV=Production).

# Strong random secret — min 32 characters (framework enforces in Production).
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars

# Host port mapping for dmbit container.
DMBIT_PORT=5100

# Bare-metal / VM deploy (no Docker):
# APP_ENV=Production
# JWT_SECRET=...
# SQLite database file (app.db) is created next to the binary at runtime.
