# Generated by Cargo
# will have compiled files and executables
target/
output/
.tools/*
!.tools/zig-link.bat
!.tools/zig-cc.bat
!.tools/zig-c++.bat
!.tools/zig-ar.bat
publish/
# Cargo.lock is NOT ignored because this workspace contains binary crates
# (the lrwf-demo crate). See:
# https://doc.rust-lang.org/cargo/guide/cargo-toml-vs-cargo-lock.html

# These are backup files generated by rustfmt
**/*.rs.bk

# Local runtime SQLite databases
*.db
*.db-shm
*.db-wal

# IDE / AI agent helpers (do not publish)
.cursor/
.trae/
.agents/
.idea/
.vscode/
*.swp
*.swo

# Optional local staging of sibling docs (scripts/sync-docs.*). Never commit these.
# Publish copies directly from source repos; only docs/rust-webx/ is in git.
docs/rust-dix/
docs/rust-ef/
docs/rust-agent-framework/
docs/rust-gpui-rml/

# Local cargo config (Windows zig cross); see .cargo/config.windows.toml
.cargo/config.toml
